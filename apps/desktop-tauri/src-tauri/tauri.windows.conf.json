{
  "$schema": "https://schema.tauri.app/config/2",
  "bundle": {
    "targets": [
      "nsis"
    ],
    "resources": {
      "../../../dist/VoxGolem-windows/*.dll": "."
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "template": "../../../target/cross-shims/windows-installer.nsi",
        "installMode": "currentUser",
        "startMenuFolder": null,
        "compression": "lzma"
      }
    }
  }
}

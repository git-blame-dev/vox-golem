{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VoxGolem",
  "version": "0.1.0",
  "identifier": "dev.gitblame.voxgolem",
  "build": {
    "beforeDevCommand": "bun run --cwd frontend/app dev",
    "beforeBuildCommand": "bun run --cwd frontend/app build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../../../frontend/app/dist"
  },
  "app": {
    "windows": [
      {
        "title": "VoxGolem",
        "width": 1200,
        "height": 800,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$RESOURCE/**"
        ]
      },
      "csp": "default-src 'self' tauri: asset:; connect-src 'self' ipc:; img-src 'self' asset: data:; media-src 'self' asset: data:; style-src 'self' 'unsafe-inline'; script-src 'self'",
      "devCsp": "default-src 'self' tauri: asset:; connect-src 'self' ipc: http://localhost:5173 ws://localhost:5173; img-src 'self' asset: data:; media-src 'self' asset: data:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "targets": [
      "appimage"
    ],
    "linux": {
      "appimage": {
        "bundleMediaFramework": true
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDVBRTA3MjZFQzkxMUVFNzEKUldSeDdoSEpibkxnV2tnRExUQ3crUWE1L1BOMXBtYXh4RW41OEZ5eWcxVnlhakl5Y2FOYUI1SUQK",
      "endpoints": [
        "https://github.com/git-blame-dev/vox-golem/releases/latest/download/latest.json"
      ]
    }
  }
}
